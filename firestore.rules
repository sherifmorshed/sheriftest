rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════════
    //  WHO IS WHO
    // ══════════════════════════════════════════════════════════════
    // Full control: uploads every dataset, writes everywhere.
    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'sherifmorshed@gmail.com';
    }

    // Outside parties: signed in, but NOT PETROBEL staff, and never allowed to
    // see PETROBEL well data.
    //
    // As of v104 this list exists purely as a backstop. Ras Gara moved to its
    // own application on its own Firebase project, and the instruction is to
    // DELETE rasgara@petrobel.org from this project's Authentication → Users.
    // The address stays listed here anyway, because "delete the account" is a
    // manual step in a console and manual steps get skipped. If it is skipped,
    // this line is the difference between an unused login and an outside party
    // holding a full copy of the well database.
    //
    // Add any future partner account here BEFORE creating it.
    function isExternal() {
      return request.auth != null
          && request.auth.token.email in ['rasgara@petrobel.org'];
    }

    // PETROBEL staff = any signed-in user who is not an outside party.
    function isStaff() {
      return request.auth != null && !isExternal();
    }

    // ══════════════════════════════════════════════════════════════
    //  PETROBEL DATA — staff read, admin writes
    // ══════════════════════════════════════════════════════════════

    // ── Main wells situation data ─────────────────
    match /wells/landWells {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    // ── Wells Test History (per-well docs + meta) ──
    match /wellsHistory/{wellId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    match /wellsHistoryMeta/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    // ── Lab W.C. History (per-well docs + meta) ────
    match /wellsWCHistory/{wellId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    match /wellsWCHistoryMeta/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    // ── Water Disposal (per-well docs + meta) ──────
    match /disposalHistory/{wellId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    match /disposalHistoryMeta/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    // ── Loss Analysis — monthly baseline snapshots ──
    match /wellsSnapshots/{date} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    match /wellsSnapshotsMeta/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    // ── Chemical Injection Survey (daily report) ────
    match /chemSurvey/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }
    match /chemSurveyMeta/{docId} {
      allow read:  if isStaff();
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════════
    //  RAS GARA — admin read-only, retained for migration
    // ══════════════════════════════════════════════════════════════
    // These collections are no longer written by this app: Ras Gara is its own
    // application on its own project as of v104. The documents are left in
    // place, readable by the admin only, so migration/export-rasgara.html can
    // still pull the history across.
    //
    // Once the export has been imported into the new project AND verified,
    // delete this block and delete the two collections. Until then, leaving
    // them costs nothing and losing them costs the entire reading history.
    match /rasGara/{date} {
      allow read:  if isAdmin();
      allow write: if false;
    }
    match /rasGaraMeta/{docId} {
      allow read:  if isAdmin();
      allow write: if false;
    }

    // ── Deny everything else by default ────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
